{
  "name": "@playhex/tournament-organizer",
  "version": "3.11.0",
  "description": "JavaScript library for running tournaments (PlayHex fork of tournament-organizer)",
  "exports": {
    ".": "./dist/index.js",
    "./interfaces": "./dist/interfaces/index.js",
    "./components": "./dist/components/index.js",
    "./pairings": "./dist/pairings/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=19"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "docs": "typedoc --options typedoc.json",
    "test": "mocha"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/playhex/tournament-organizer.git"
  },
  "keywords": [
    "tournament",
    "pairings",
    "scorekeeping",
    "swiss",
    "round robin",
    "single elimination",
    "double elimination"
  ],
  "author": "Matt Braddock",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/playhex/tournament-organizer/issues"
  },
  "homepage": "https://github.com/playhex/tournament-organizer#readme",
  "dependencies": {
    "edmonds-blossom-fixed": "^1.0.1"
  },
  "devDependencies": {
    "@types/chai": "^5.2.0",
    "@types/edmonds-blossom": "^1.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.12",
    "chai": "^5.2.0",
    "mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.27.4",
    "typedoc-plugin-merge-modules": "^6.1.0",
    "typescript": "^5.8.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
